@model SimplePayConfigurationModel

@{
    Layout = "_ConfigurePlugin";
    NopHtml.SetActiveMenuItemSystemName($"{SimplePayDefaults.SystemName} Configuration");
}

@await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))

@await Component.InvokeAsync(typeof(SettingModeViewComponent))

<form asp-controller="SimplePayConfiguration" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default card-outline card-info" id="pnlOnboarding">
            <div class="card-header">
                @T("Plugins.Payments.SimplePay.Onboarding.Title")
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="Merchant" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Merchant" />
                        <span asp-validation-for="Merchant"></span>
                    </div>
                    <div class="col-md-3">
                        <nop-label asp-for="MerchantKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="MerchantKey" />
                        <span asp-validation-for="MerchantKey"></span>
                    </div>
                    <div class="col-md-3">
                        <nop-label asp-for="DefaultCurrency" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="DefaultCurrency" />
                    </div>
                    <div class="col-md-3">
                        <nop-label asp-for="IsDefaultCurrencyUsed" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="IsDefaultCurrencyUsed" />
                    </div>
                    <div class="col-md-3">
                        <nop-label asp-for="IsTwoStep" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="IsTwoStep" />
                    </div>
                    <div class="col-md-3">
                        <nop-label asp-for="AdditionalFee" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AdditionalFee" />
                        <span asp-validation-for="AdditionalFee"></span>
                    </div>
                    <div class="col-md-3">
                        <nop-label asp-for="UseSandbox" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="UseSandbox" />
                    </div>
                    <div class="col-md-3">
                        <nop-label asp-for="AddExtraPercentageToOrderTotal" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AddExtraPercentageToOrderTotal" />
                        <span asp-validation-for="AddExtraPercentageToOrderTotal"></span>
                    </div>
                    <div class="col-md-3">
                        <nop-label asp-for="AddExtraToOrderTotal" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AddExtraToOrderTotal" />
                        <span asp-validation-for="AddExtraToOrderTotal"></span>
                    </div>
                    <!-- Advanced settings -->
                    <div id="prominently-card" class="card card-default advanced-setting">
                        <div class="card-header">
                            @T(Configuration.SIMPLE_PAY_CONFIGURATION_ADVANCED)
                        </div>
                        <div class="card-body">
                            <div class="form-group row advanced-setting">
                                <div class="col-md-3">
                                    <nop-label asp-for="RetentionPolicyInDay" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="RetentionPolicyInDay" />
                                    <span asp-validation-for="RetentionPolicyInDay"></span>
                                </div>
                                <div class="col-md-3">
                                    <nop-label asp-for="HasDetailedItems" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="HasDetailedItems" />
                                </div>
                                <div class="col-md-3">
                                    <nop-label asp-for="OneItemName" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="OneItemName" />
                                    <span asp-validation-for="OneItemName"></span>
                                </div>
                                <div class="col-md-3">
                                    <nop-label asp-for="OtpIpnAddress" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="OtpIpnAddress" />
                                    <span asp-validation-for="OtpIpnAddress"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group row" id="pnlSave">
                <div class="col-md-9 offset-md-3">
                    <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                </div>
            </div>
        </div>
    </div>
</form>